diff --git a/wan/modules/attention.py b/wan/modules/attention.py
index c84d9e5..05d71c2 100644
--- a/wan/modules/attention.py
+++ b/wan/modules/attention.py
@@ -52,6 +52,27 @@ def flash_attention(
     assert dtype in half_dtypes
     assert q.device.type == 'cuda' and q.size(-1) <= 256
 
+    if not (FLASH_ATTN_2_AVAILABLE or FLASH_ATTN_3_AVAILABLE):
+        assert window_size == (-1, -1), 'SDPA fallback: window_size unsupported'
+        out_dtype = q.dtype
+        b, lq = q.size(0), q.size(1)
+        out = q.new_zeros(q.shape[:-1] + (v.size(-1),), dtype=out_dtype)
+        for i in range(b):
+            ql = lq if q_lens is None else int(q_lens[i])
+            kl = k.size(1) if k_lens is None else int(k_lens[i])
+            qi = q[i:i + 1, :ql]
+            if q_scale is not None:
+                qi = qi * q_scale
+            qi = qi.to(dtype if qi.dtype not in half_dtypes else qi.dtype)
+            ki = k[i:i + 1, :kl].to(qi.dtype)
+            vi = v[i:i + 1, :kl].to(qi.dtype)
+            oi = torch.nn.functional.scaled_dot_product_attention(
+                qi.transpose(1, 2), ki.transpose(1, 2), vi.transpose(1, 2),
+                dropout_p=dropout_p, is_causal=causal, scale=softmax_scale,
+                enable_gqa=(qi.size(2) != ki.size(2)))
+            out[i, :ql] = oi.transpose(1, 2).to(out_dtype)
+        return out
+
     # params
     b, lq, lk, out_dtype = q.size(0), q.size(1), k.size(1), q.dtype
 
